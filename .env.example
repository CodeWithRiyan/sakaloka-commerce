# Copy to .env.local for local development. Never commit real values.
# In preview and production, set these in Vercel's environment variables.

# Store name shown in the navbar, page titles and footer
STORE_NAME=Sakaloka Store

# SQLite. Locally a file; in Vercel a Turso URL such as libsql://<database>-<org>.turso.io
DATABASE_URL=file:./data/app.db
# Turso auth token; leave empty for a local file
DATABASE_AUTH_TOKEN=

# File storage: disk (local folder) or blob (Vercel Blob, added in T-PR-03)
STORAGE_DRIVER=disk
# Local folder for the disk driver
STORAGE_DISK_ROOT=./data/uploads
# Vercel Blob tokens, used when STORAGE_DRIVER=blob
BLOB_PUBLIC_TOKEN=
BLOB_PRIVATE_TOKEN=

# Public base URL of the site
APP_URL=http://localhost:3000

# Email (added in T-PR-04)
SMTP_URL=
MAIL_FROM=

# Shared secret Vercel Cron sends as a bearer token (added in T-PR-05)
CRON_SECRET=
