# Copy to .env.local for local development. Never commit real values.
# In preview and production, set these in Vercel's environment variables.

# SQLite. Locally a file; in Vercel a Turso URL such as libsql://i2i-<org>.turso.io
DATABASE_URL=file:./data/i2i.db
# Turso auth token; leave empty for a local file
DATABASE_AUTH_TOKEN=

# File storage: disk (local folder) or blob (Vercel Blob)
STORAGE_DRIVER=disk
# Local folder for the disk driver
STORAGE_DISK_ROOT=./data/uploads
# Vercel Blob tokens, used when STORAGE_DRIVER=blob (added in T-R1-08)
BLOB_PUBLIC_TOKEN=
BLOB_PRIVATE_TOKEN=

# Public base URL of the site
APP_URL=http://localhost:3000

# Email (added in T-R3-10)
SMTP_URL=
MAIL_FROM=

# Shared secret Vercel Cron sends as a bearer token (added in T-R1-10)
CRON_SECRET=
